# Citron OS Plymouth script theme: pulsing dots and a progress bar.

Window.SetBackgroundTopColor(0.055, 0.075, 0.105);
Window.SetBackgroundBottomColor(0.105, 0.155, 0.16);

logo.original_image = Image("citron-mark.png");
logo.image = logo.original_image.Scale(144, 144);
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2,
                        Window.GetY() + Window.GetHeight() * 0.22 - logo.image.GetHeight() / 2, 10);

title.image = Image.Text("CITRON OS", 0.94, 0.95, 0.89);
title.sprite = Sprite(title.image);
title.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - title.image.GetWidth() / 2,
                         Window.GetY() + Window.GetHeight() * 0.48, 10);

subtitle.image = Image.Text("Chargement du système", 0.72, 0.77, 0.74);
subtitle.sprite = Sprite(subtitle.image);
subtitle.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - subtitle.image.GetWidth() / 2,
                            Window.GetY() + Window.GetHeight() * 0.55, 10);

dot.image = Image("progress-dot.png");
dot1.sprite = Sprite(dot.image);
dot2.sprite = Sprite(dot.image);
dot3.sprite = Sprite(dot.image);
dot1.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - 31, Window.GetY() + Window.GetHeight() * 0.64, 10);
dot2.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - 10, Window.GetY() + Window.GetHeight() * 0.64, 10);
dot3.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 + 11, Window.GetY() + Window.GetHeight() * 0.64, 10);

track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.x = Window.GetX() + Window.GetWidth() / 2 - track.image.GetWidth() / 2;
track.y = Window.GetY() + Window.GetHeight() * 0.74;
track.sprite.SetPosition(track.x, track.y, 10);

progress.original_image = Image("progress-fill.png");
progress.sprite = Sprite();
progress.image = progress.original_image.Scale(1, progress.original_image.GetHeight());
progress.sprite.SetImage(progress.image);
progress.sprite.SetPosition(track.x, track.y, 11);

global.phase = 0;
fun refresh_callback ()
  {
    global.phase += 0.075;
    dot1.sprite.SetOpacity(0.22 + 0.78 * (Math.Cos(global.phase) + 1) / 2);
    dot2.sprite.SetOpacity(0.22 + 0.78 * (Math.Cos(global.phase - 2.1) + 1) / 2);
    dot3.sprite.SetOpacity(0.22 + 0.78 * (Math.Cos(global.phase - 4.2) + 1) / 2);
  }
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, value)
  {
    if (value < 0)
      value = 0;
    if (value > 1)
      value = 1;
    global.width = Math.Int(progress.original_image.GetWidth() * value);
    if (global.width < 1)
      global.width = 1;
    progress.image = progress.original_image.Scale(global.width, progress.original_image.GetHeight());
    progress.sprite.SetImage(progress.image);
  }
Plymouth.SetBootProgressFunction(progress_callback);

fun display_message_callback (text)
  {
    message.image = Image.Text(text, 0.72, 0.77, 0.74);
    message.sprite = Sprite(message.image);
    message.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2,
                                Window.GetY() + Window.GetHeight() * 0.84, 100);
  }
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun quit_callback ()
  {
    logo.sprite.SetOpacity(1);
  }
Plymouth.SetQuitFunction(quit_callback);
